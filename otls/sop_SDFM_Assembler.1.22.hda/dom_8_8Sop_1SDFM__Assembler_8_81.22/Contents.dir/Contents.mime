--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/vdbfrompolygons2.spareparmdef"
Content-Type: text/plain

    parm {
        name    "voxelsize"
        baseparm
        label   "Voxel Size"
        export  none
    }
    parm {
        name    "group"
        baseparm
        label   "Reference VDB"
        export  none
    }
    parm {
        name    "builddistance"
        baseparm
        label   ""
        joinnext
        export  none
    }
    parm {
        name    "distancename"
        baseparm
        label   "Distance VDB"
        export  none
    }
    parm {
        name    "buildfog"
        baseparm
        label   ""
        joinnext
        export  none
    }
    parm {
        name    "fogname"
        baseparm
        label   "Fog VDB"
        export  none
    }
    parm {
        name    "useworldspaceunits"
        baseparm
        label   "Use World Space Units for Narrow Band"
        export  none
    }
    parm {
        name    "exteriorbandvoxels"
        baseparm
        label   "Exterior Band Voxels"
        export  none
    }
    parm {
        name    "interiorbandvoxels"
        baseparm
        label   "Interior Band Voxels"
        export  none
    }
    parm {
        name    "exteriorband"
        baseparm
        label   "Exterior Band"
        export  none
    }
    parm {
        name    "interiorband"
        baseparm
        label   "Interior Band"
        export  none
    }
    parm {
        name    "fillinterior"
        baseparm
        label   "Fill Interior"
        export  none
    }
    parm {
        name    "unsigneddist"
        baseparm
        label   "Unsigned Distance Field"
        export  none
    }
    multiparm {
        name    "numattrib"
        label    "Surface Attributes"
        baseparm
        default 0
        parmtag { "houdini_utils::doc" "Generate additional VDB primitives that store the values of primitive (face), point, or vertex [attributes|/model/attributes].\n\nOnly voxels in the narrow band around the surface will be set." }

        parm {
            name    "attribute#"
            baseparm
            label   "Attribute"
            export  none
        }
        parm {
            name    "attributevdbname#"
            baseparm
            label   "VDB Name"
            export  none
        }
        parm {
            name    "vectype#"
            baseparm
            label   "Vector Type"
            export  none
        }
    }

    parm {
        name    "spare_input0"
        label   "Spare Input 0"
        type    oppath
        default { "" }
        help    "Refer to this in expressions as -1, such as: npoints(-1)"
        parmtag { "cook_dependent" "1" }
        parmtag { "opfilter" "!!SOP!!" }
        parmtag { "oprelative" "." }
    }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/vdbfrompolygons2.chn"
Content-Type: text/plain

{
    channel voxelsize {
      lefttype = extend
      righttype = extend
      default = 0.10000000000000001
      flags = 0
      segment { length = 0 value = 0.10000000000000001 0.10000000000000001 expr = detail(\"../ResCalc/\",\"voxelsize\",0) }
    }
    channel exteriorband {
      lefttype = extend
      righttype = extend
      default = 0.022212348878383636
      flags = 0
      segment { length = 0 value = 0.022212348878383636 0.022212348878383636 expr = max(max(prim(-1,0,\"R\",0),prim(-1,0,\"RA\",0))+ch(\"voxelsize\"),ch(\"../minhalfbanddist\")) }
    }
  }

