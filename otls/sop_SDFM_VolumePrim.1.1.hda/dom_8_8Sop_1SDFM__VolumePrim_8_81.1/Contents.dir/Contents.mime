Content-Type: text/plain

    parm {
        name    "copyinput"
        baseparm
        label   "Copy Input (Note: Input will be still cooked if disabled)"
        invisible
        export  none
    }
    parm {
        name    "cacheinput"
        baseparm
        label   "Cache Input"
        invisible
        export  none
    }
    parm {
        name    "nullplus"
        label   "Show Null+"
        type    button
        default { "0" }
        parmtag { "script_callback" "n = hou.node(\".\"); ntg = n.parmTemplateGroup(); fol = ntg.find(\"null\"); ntg.hide(fol, False); n.setParmTemplateGroup(ntg)" }
        parmtag { "script_callback_language" "python" }
    }
    groupcollapsible {
        name    "null"
        label   "null"
        invisibletab

        parm {
            name    "nullplus2"
            label   "Hide Null+"
            type    button
            default { "0" }
            parmtag { "script_callback" "n = hou.node(\".\"); ntg = n.parmTemplateGroup(); fol = ntg.find(\"null\"); ntg.hide(fol, True); n.setParmTemplateGroup(ntg)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "sepparm7"
            label   "Separator"
            type    separator
            default { "" }
        }
        parm {
            name    "create"
            label   "Create Object Merge"
            type    button
            default { "1" }
            range   { 0 1 }
            parmtag { "script_callback" "node = hou.pwd(); node_path = node.path(); node_name = node.name(); pos = node.position(); pos2 = (pos[0], pos[1] - 1); parent = node.parent(); path = parent.path(); root = hou.node(path); new_node = root.createNode('object_merge'); new_node.setPosition(pos2); new_node.parm(\"objpath1\").set(node_path); new_node.setName(\"merge_\" + node_name, True); " }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "sepparm5"
            label   "Separator"
            type    separator
            default { "" }
        }
        parm {
            name    "set_name_in"
            label   "IN"
            type    button
            joinnext
            default { "1" }
            range   { 0 1 }
            parmtag { "script_callback" "hou.pwd().setName(\"IN\", True); hou.pwd().setRenderFlag(True); hou.pwd().setDisplayFlag(True); hou.pwd().setColor(hou.Color((0.38,0.4,0.55)))" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "set_name_out"
            label   "OUT"
            type    button
            joinnext
            default { "1" }
            range   { 0 1 }
            parmtag { "script_callback" "hou.pwd().setName(\"OUT\", True); hou.pwd().setRenderFlag(True); hou.pwd().setDisplayFlag(True); hou.pwd().setColor(hou.Color((0.09,0.36,0.69)))" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "sepparm4"
            label   "Separator"
            type    separator
            default { "" }
        }
        parm {
            name    "set_name_in2"
            label   "CONTROL"
            type    button
            joinnext
            default { "1" }
            range   { 0 1 }
            parmtag { "script_callback" "hou.pwd().setName(\"Control\", True); hou.pwd().setRenderFlag(False); hou.pwd().setDisplayFlag(True); hou.pwd().setColor(hou.Color((0,0,1)))" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "sepparm8"
            label   "Separator"
            type    separator
            default { "" }
        }
        parm {
            name    "set_name_prep"
