Content-Type: text/plain

{
    channel shelltoggle {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../shelltoggle\") }
    }
    channel shellthickness {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 value = 0.050000000000000003 0.050000000000000003 expr = ch(\"../shellthickness\") }
    }
    channel colorbymode {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../colorbymode\") }
    }
    channel combinemode {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../combinemode\") }
    }
    channel typeuni {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../typeuni\") }
    }
    channel typeinters {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../typeinters\") }
    }
    channel typediff {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../typediff\") }
    }
    channel typeoth {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../typeoth\") }
    }
    channel radius {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 value = 0.033000000000000002 0.033000000000000002 expr = ch(\"../radius\") }
    }
    channel offset {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../offset\") }
    }
    channel radiusa {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 value = 0.050000000000000003 0.050000000000000003 expr = ch(\"../radiusa\") }
    }
    channel radiusb {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 value = 0.050000000000000003 0.050000000000000003 expr = ch(\"../radiusb\") }
    }
    channel count {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../count\") }
