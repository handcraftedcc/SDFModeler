    }
    channel centery {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = centroid(\"../READ_Bound/\",D_Y) }
    }
    channel centerz {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = centroid(\"../READ_Bound/\",D_Z) }
    }
    channel sizex {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = bbox(\"../READ_Bound/\",D_XSIZE) }
    }
    channel sizey {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = bbox(\"../READ_Bound/\",D_YSIZE) }
    }
    channel sizez {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = bbox(\"../READ_Bound/\",D_ZSIZE) }
    }
    channel voxelsize {
      lefttype = extend
      righttype = extend
      default = 38.679905409771798
      flags = 0
      segment { length = 0 value = 38.679905409771798 38.679905409771798 expr = detail(\"../ResCalc/\",\"voxelsize\",0) }
    }
  }

