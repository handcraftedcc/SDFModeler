--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/VolumeProcessing.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
bindeach	[ 0	locks=0 ]	(	"off"	)
snippet	[ 0	locks=0 ]	(	"////////////////////////////////////////////////////////////////
//
//             CREDIT
//
////////////////////////////////////////////////////////////////
/*      
        A good portion of the SDF creation code was taken and adapted from mercury.sexy/hg_sdf:
        MIT License
        Copyright (c) 2011-2021 Mercury Demogroup
        title = {HG_SDF: A glsl library for building signed distance functions},
        author = {Kornd\\\"orfer, Johann and Keinert, Benjamin and Ganse, Urs and S\\\"anger, Michael and Ley, Simon and Burkhardt, Konstanze and Spuler, Mario and Heusipp, J\\\"orn},
        year = {2015}, 
        howpublished = {\\url{https://mercury.sexy/hg_sdf}},
        note = {Accessed: 2021-07-28}
*/ 



////////////////////////////////////////////////////////////////
//
//             HELPER FUNCTIONS/MACROS
//
////////////////////////////////////////////////////////////////

#define PI 3.14159265
#define TAU (2*PI)
#define PHI (sqrt(5)*0.5 + 0.5)

#define saturate(x) clamp(x, 0, 1)

// Sign function that doesn't return 0
float sgn(float x) {
        return (x<0)?-1:1;
}

vector2 sgn(vector2 v) {
        return set((v.x<0)?-1:1, (v.y<0)?-1:1);
}

float square (float x) {
        return x*x;
}

vector2 square (vector2 x) {
        return x*x;
}

vector square (vector x) {
        return x*x;
}

float lengthSqr(vector x) {
        return dot(x, x);
}


// Maximum/minumum elements of a vector
float vmax(vector2 v) {
        return max(v.x, v.y);
}

float vmax(vector v) {
        return max(max(v.x, v.y), v.z);
}

float vmax(vector4 v) {
        return max(max(v.x, v.y), max(v.z, v.w));
}

float vmin(vector2 v) {
        return min(v.x, v.y);
}

float vmin(vector v) {
        return min(min(v.x, v.y), v.z);
}

float vmin(vector4 v) {
        return min(min(v.x, v.y), min(v.z, v.w));
}

////////////////////////////////////////////////////////////////
//
//             PRIMITIVE DISTANCE FUNCTIONS
//
////////////////////////////////////////////////////////////////

float fSphere(vector p; vector r) {
        p*= {1,1,1}/r;
        return length(p) - 1;
}

// Cheap Box: distance to corners is overestimated
float fBoxCheap(vector p; vector b) { //cheap box
        return vmax(abs(p) - b);
}

// Box: correct distance to corners
float fBox(vector p; vector b) {
        vector d = abs(p) - b;
        return length(max(d, {0,0,0})) + vmax(min(d, {0,0,0}));
}

float chamferBox(vector position; vector halfSize; float chamferRadius) {   
        vector position1 = position - clamp(position, chamferRadius - halfSize, halfSize - chamferRadius);
        position1 = abs(position1);
        float d1 = (position1.x + position1.y + position1.z - chamferRadius) / 3.0;
        vector point = position1 - d1;
        vector d2 = min(point, 0.0);
        point += (d2.x + d2.y + d2.z) * 0.5 - d2 * 1.5;
        point = clamp(point, 0.0, chamferRadius); 
        float d3 = length(position1 - point) * sign(d1);
        vector position2 = abs(position) - halfSize;
        float d4 = max(max(position2.x, position2.y), position2.z);
        float d5 = (position2.x + position2.y + position2.z + 2.0 * chamferRadius) / sqrt(3.0);
        float d6 = (max(max(position2.x + position2.y, position2.x + position2.z), position2.y + position2.z) + chamferRadius) / sqrt(2.0);
        return max(d3, 0.0) + min(max(max(d4, d5), d6), 0.0);
}

float bevelBox(vector position; vector halfSize; float bevelRadius) 
{
        position = abs(position) - halfSize + bevelRadius;
        return length(max(position, 0.0)) + min(max(max(position.x, position.y), position.z), 0.0) - bevelRadius;
}


// Cylinder standing upright on the xz plane
float fCylinder(vector p; float r; float r2; float height) {
        float ratio = r/r2;
        p.z*=ratio;
        float d = length(set(p.x,p.z)) - r;
        d = max(d, abs(p.y) - height);
        return d;
}

float chamferCylinder(vector p; float r; float r2; float height; float chamferRadius) {
        float ratio = r/r2;
        p.z*=ratio;
        vector2 position = set(p.y,length(set(p.x,p.z)));
        position = abs(position) - set(height,r);
        vector2 d1 = set(max(position.x + chamferRadius, 0.0), position.y);
        vector2 d2 = set(position.x, max(position.y + chamferRadius, 0.0));
        float k = clamp((position.x - position.y + chamferRadius) * 0.5, 0.0, chamferRadius);
        vector2 d3 = position + set(chamferRadius - k, k);
        float s = sign(max(d3.x, d1.y));
        float result = sqrt(min(min(dot(d1, d1), dot(d2, d2)), dot(d3, d3))) * s;
        return result/ratio;
}

float roundCylinder(vector p; float r; float r2; float height; float cornerRadius) {
        float ratio = r/r2;
        p.z*=ratio;
        vector2 position = set(p.y,length(set(p.x,p.z)));
        position = abs(position) - set(height,r) + cornerRadius;
        return length(max(position, 0.0)) + min(max(position.x, position.y), 0.0) - cornerRadius;
}

// Capsule: A Cylinder with round caps on both sides
float fCapsule(vector p; float r1; float r2; float height) {
        float c = max(height*0.5 - r1,height*0.5 - r2,0.00001);
        float r = min(r1,r2,height*0.5);
        if(r1<r2) p.z*= r1/r2;
        if(r2<r1) p.x*= r2/r1;
        float result = lerp(length(set(p.x,p.z,0)) - r, length(set(p.x, abs(p.y) - c, p.z)) - r, filterstep(c, abs(p.y)));
        return result;
}


// Torus in the XZ-plane
float fTorus(vector p; float r1; float r2; float height) 
{
        float smallRadius = min(height*0.5,min(r1*0.5,r2*0.5)*0.5);      
        float largeRadius = max(min(r1*0.5,r2*0.5),height*0.5)-smallRadius;
        if(r1<r2) p.z*= r1/r2;
        if(r2<r1) p.x*= r2/r1;
        return length(set(length(set(p.x,p.z)) - largeRadius, p.y)) - smallRadius;
}


// Cone with correct distances to tip and base circle. Y is up, 0 is in the middle of the base.
float fCone(vector p; float radius; float height) {
        vector2 q = set(length(set(p.x,p.z)), p.y);
        vector2 tip = q - set(0, height);
        vector2 mantleDir = normalize(set(height, radius));
        float mantle = dot(tip, mantleDir);
        float d = max(mantle, -q.y);
        float projected = dot(tip, set(mantleDir.y, -mantleDir.x));
        
        // distance to tip
        if ((q.y > height) && (projected < 0)) {
                d = max(d, length(tip));
        }
        
        // distance to base ring
        if ((q.x > radius) && (projected > length(set(height, radius)))) {
                d = max(d, length(q - set(radius, 0)));
        }
        return d;
}

float sdPyramid( vector p; vector size)
{
        float h = size.y;
        p.y+=h*0.5;
        p.x *= 1.0/size.x;
        p.z *= 1.0/size.z;
        
        float m2 = h*h + 0.25;
        
        vector2 xz = set(p.x,p.z);
        vector2 zx = set(p.z,p.x);

        
              
        xz = abs(xz); // do p=abs(p) instead for double pyramid
        zx = abs(zx);
        xz = (zx[0]>zx[1]) ? zx : xz;
        xz -= 0.5;

        p.x = xz[0];
        p.z = xz[1];
        
        vector q = set( p.z, h*p.y - 0.5*p.x, h*p.x + 0.5*p.y);
        
        float s = max(-q.x,0.0);
        float t = clamp( (q.y-0.5*p.z)/(m2+0.25), 0.0, 1.0 );
        
        float a = m2*(q.x+s)*(q.x+s) + q.y*q.y;
        float b = m2*(q.x+0.5*t)*(q.x+0.5*t) + (q.y-m2*t)*(q.y-m2*t);
        
        float d2 = min(q.y,-q.x*m2-q.y*0.5) > 0.0 ? 0.0 : min(a,b);
        
        float result = sqrt( (d2+q.z*q.z)/m2 ) * sign(max(q.z,-p.y));
        return result;

}

float sdOctahedron( vector p; vector size )
{
        float h = size.y*0.5;
        p.x *= 1.0/size.x;
        p.z *= 1.0/size.z;
        
        float m2 = h*h + 0.25;
        
        p=abs(p);

        vector2 xz = set(p.x,p.z);
        vector2 zx = set(p.z,p.x);


        xz = (zx[0]>zx[1]) ? zx : xz;
        xz -= 0.5;

        p.x = xz[0];
        p.z = xz[1];
        
        vector q = set( p.z, h*p.y - 0.5*p.x, h*p.x + 0.5*p.y);
        
        float s = max(-q.x,0.0);
        float t = clamp( (q.y-0.5*p.z)/(m2+0.25), 0.0, 1.0 );
        
        float a = m2*(q.x+s)*(q.x+s) + q.y*q.y;
        float b = m2*(q.x+0.5*t)*(q.x+0.5*t) + (q.y-m2*t)*(q.y-m2*t);
        
        float d2 = min(q.y,-q.x*m2-q.y*0.5) > 0.0 ? 0.0 : min(a,b);
        
        return sqrt( (d2+q.z*q.z)/m2 ) * sign(max(q.z,-p.y));
}


////////////////////////////////////////////////////////////////
//
//                DOMAIN MANIPULATION OPERATORS
//
////////////////////////////////////////////////////////////////



// Rotate around a coordinate axis (i.e. in a plane perpendicular to that axis) by angle <a>.
// Read like this: R(set(p.x,p.z), a) rotates \"x towards z\".
// This is fast if <a> is a compile-time constant and slower (but still practical) if not.
void pR(export vector2 p; float a) {
        p = cos(a)*p + sin(a)*set(p.y, -p.x);
}

// Shortcut for 45-degrees rotation
void pR45(export vector2 p) {
        p = (p + set(p.y, -p.x))*sqrt(0.5);
}

// Repeat space along one axis. Use like this to repeat along the x axis:
// <float cell = pMod1(p.x,5);> - using the return value is optional.
float pMod1(export float p; float size) {
        float halfsize = size*0.5;
        float c = floor((p + halfsize)/size);
        p = ((p + halfsize) % size) - halfsize;
        return c;
}

// Same, but mirror every second cell at the diagonal as well
vector2 pModGrid2(export vector2 p; vector2 size) {
        vector2 c = floor((p + size*0.5)/size);
        p = ((p + size*0.5) % size) - size*0.5;
        p *= (c % set(2))*2 - set(1);
        p -= size/2;
        if (p.x > p.y) p.xy = p.yx;
        return floor(c/2);
}

////////////////////////////////////////////////////////////////
//
//             OBJECT COMBINATION OPERATORS
//
////////////////////////////////////////////////////////////////

// The \"Chamfer\" flavour makes a 45-degree chamfered edge (the diagonal of a square of size <r>):
float fOpUnionChamfer(float a; float b; float r) {
        return min(min(a, b), (a - r + b)*sqrt(0.5));
}

// Intersection has to deal with what is normally the inside of the resulting object
// when using union, which we normally don't care about too much. Thus, intersection
// implementations sometimes differ from union implementations.
float fOpIntersectionChamfer(float a; float b; float r) {
        return max(max(a, b), (a + r + b)*sqrt(0.5));
}

// Difference can be built from Intersection or Union:
float fOpDifferenceChamfer (float a; float b; float r) {
        return fOpIntersectionChamfer(a, -b, r);
}

// The \"Round\" variant uses a quarter-circle to join the two objects smoothly:
float fOpUnionRound(float a; float b; float r) {
        vector2 u = max(set(r - a,r - b), set(0));
        return max(r, min (a, b)) - length(u);
}

float fOpIntersectionRound(float a; float b; float r) {
        vector2 u = max(set(r + a,r + b), set(0));
        return min(-r, max (a, b)) + length(u);
}

float fOpDifferenceRound (float a; float b; float r) {
        return fOpIntersectionRound(a, -b, r);
}


// The \"Columns\" flavour makes n-1 circular columns at a 45 degree angle:
float fOpUnionColumns(float a; float b; float r; float n) {
        if ((a < r) && (b < r)) {
                vector2 p = set(a, b);
                float columnradius = r*sqrt(2)/((n-1)*2+sqrt(2));
                pR45(p);
                p.x -= sqrt(2)/2*r;
                p.x += columnradius*sqrt(2);
                if ((n%2) == 1) {
                        p.y += columnradius;
                }
                // At this point, we have turned 45 degrees and moved at a point on the
                // diagonal that we want to place the columns on.
                // Now, repeat the domain along this direction and place a circle.
                pMod1(p.y, columnradius*2);
                float result = length(p) - columnradius;
                result = min(result, p.x);
                result = min(result, a);
                return min(result, b);
        } else {
                return min(a, b);
        }
}

float fOpDifferenceColumns(float a; float b; float r; float n) {
        a = -a;
        float m = min(a, b);
        //avoid the expensive computation where not needed (produces discontinuity though)
        if ((a < r) && (b < r)) {
                vector2 p = set(a, b);
                float columnradius = r*sqrt(2)/n/2.0;
                columnradius = r*sqrt(2)/((n-1)*2+sqrt(2));

                pR45(p);
                p.y += columnradius;
                p.x -= sqrt(2)/2*r;
                p.x += -columnradius*sqrt(2)/2;

                if ((n%2) == 1) {
                        p.y += columnradius;
                }
                pMod1(p.y,columnradius*2);

                float result = -length(p) + columnradius;
                result = max(result, p.x);
                result = min(result, a);
                return -min(result, b);
        } else {
                return -m;
        }
}

float fOpIntersectionColumns(float a; float b; float r; float n) {
        return fOpDifferenceColumns(a,-b,r, n);
}

// The \"Stairs\" flavour produces n-1 steps of a staircase:
// much less stupid version by paniq
float fOpUnionStairs(float a; float b; float r; float n) {
        float s = r/n;
        float u = b-r;
        return min(min(a,b), 0.5 * (u + a + abs ((((u - a + s)%( 2 * s))) - s)));
}

// We can just call Union since stairs are symmetric.
float fOpIntersectionStairs(float a; float b; float r; float n) {
        return -fOpUnionStairs(-a, -b, r, n);
}

float fOpDifferenceStairs(float a; float b; float r; float n) {
        return -fOpUnionStairs(-a, b, r, n);
}


// Similar to fOpUnionRound, but more lipschitz-y at acute angles
// (and less so at 90 degrees). Useful when fudging around too much
// by MediaMolecule, from Alex Evans' siggraph slides
float fOpUnionSoft(float a; float b; float r) {
        float e = max(r - abs(a - b), 0);
        return min(a, b) - e*e*0.25/r;
}


// produces a cylindical pipe that runs along the intersection.
// No objects remain, only the pipe. This is not a boolean operator.
float fOpPipe(float a; float b; float r) {
        return length(set(a, b)) - r;
}

// first object gets a v-shaped engraving where it intersect the second
float fOpEngrave(float a; float b; float r) {
        return max(a, (a + r - abs(b))*sqrt(0.5));
}

// first object gets a capenter-style groove cut out
float fOpGroove(float a; float b; float ra; float rb) {
        return max(a, min(a + ra, rb - abs(b)));
}

// first object gets a capenter-style tongue attached
float fOpTongue(float a; float b; float ra; float rb) {
        return min(a, max(a - ra, abs(b) - rb));
}

// surface offset
float fOpOffset(float a; float b; float ra; float rb) {
        //return a-min(b+ra,0)*rb;
        return a-min(max(b-rb*0.5,-rb),0)*(1/-rb)*ra;
}

////////////////////////////////////////////////////////////////
//
//             PRIMITIVE DISTANCE FUNCTIONS - COMBINATION VARIATIONS
//
////////////////////////////////////////////////////////////////


float bevelchamferBox(vector position; vector halfSize; float bevelRadius; float chamferRadius) {
    vector halfsizeS1 = halfSize;
    halfsizeS1.y+=max(chamferRadius,bevelRadius)*2;
    vector positionS1 = position;
    float surface1 = bevelBox(positionS1, halfsizeS1, bevelRadius);
    vector halfsizeS2 = halfSize;
    halfsizeS2.y=max(chamferRadius,bevelRadius)*2;
    halfsizeS2.x*=2;
    halfsizeS2.z*=2;
    vector positionS2 = abs(position);
    positionS2.y -= halfSize.y+max(chamferRadius,bevelRadius)*2;
    float surface2 = fBox(positionS2, halfsizeS2);
    float combine = fOpDifferenceChamfer(surface1, surface2, chamferRadius);
    return combine;
}




////////////////////////////////////////////////////////////////
//
//             Main Functions
//
////////////////////////////////////////////////////////////////

float primfunc(int thisprim; vector pos; vector vid)
{
        float value;
        vector thisprimpos = prim(1,\"P\",thisprim);
        vector dimensions = prim(1,\"dimensions\",thisprim);
        vector primscale = prim(1,\"primscale\",thisprim);
        vector4 orient = prim(1,\"orient\",thisprim);
        string primtype = prim(1,\"primtype\",thisprim);
        vector p = pos;
        int edgetype = prim(1,\"edgetype\", thisprim);
        float edgerad = prim(1,\"edgerad\", thisprim);
        float edgerad2 = prim(1,\"edgerad2\", thisprim);
        int tapertoggle = prim(1,\"tapertoggle\", thisprim);
        int shelltoggle = prim(1,\"shelltoggle\", thisprim);
        int offsettoggle = prim(1,\"offsettoggle\", thisprim);
        p = p-thisprimpos;
        p = qrotate(qinvert(orient)*-1, p);
        p *= {1,1,1}/primscale;
        vector taperposmultiplier = {1,1,1};

        if(tapertoggle == 1) //stretch position values to result in chamfer
        {

                float taperamount = prim(1,\"taperamount\", thisprim);
                int taperdir = prim(1,\"taperdir\", thisprim);
                int taperx = prim(1,\"taperx\", thisprim);
                int taperz = prim(1,\"taperz\", thisprim);
                float pold = p;


                float tapermulti = fit(p[taperdir],-dimensions[taperdir]*0.5,dimensions[taperdir]*0.5,0,1);
                if(taperamount < 0) tapermulti = 1-tapermulti;
                if(taperdir == 0)
                {       
                        if(taperx == 1) taperposmultiplier.y = (1/(1-tapermulti*abs(taperamount)));
                        if(taperz == 1) taperposmultiplier.z = (1/(1-tapermulti*abs(taperamount)));
                }
                if(taperdir == 1)
                {
                        if(taperx == 1) taperposmultiplier.x *= (1/(1-tapermulti*abs(taperamount)));
                        if(taperz == 1) taperposmultiplier.z *= (1/(1-tapermulti*abs(taperamount)));
                }
                if(taperdir == 2)
                {
                        if(taperx == 1) taperposmultiplier.y *= (1/(1-tapermulti*abs(taperamount)));
                        if(taperz == 1) taperposmultiplier.x *= (1/(1-tapermulti*abs(taperamount)));
                }

                p.y*= taperposmultiplier.y;
                p.x*= taperposmultiplier.x;
                p.z*= taperposmultiplier.z;
        }
        
        if(primtype == \"box\")
        {
                vector b = dimensions*0.5;
                if(edgetype == 0)
                {
                        value = fBoxCheap(p, b);
                }
                else if(edgetype == 1)
                {
                        value = chamferBox(p, b, edgerad);
                }
                else if(edgetype == 2)
                {
                        value = bevelBox(p, b, edgerad);
                }
                else if(edgetype == 3)
                {
                        value = bevelchamferBox(p, b, edgerad, edgerad2);
                }
                
        }
        else if(primtype == \"sphere\")
        {
                vector r = dimensions*0.5;
                value = fSphere(p, r);
        }
        else if(primtype == \"tube\")
        {
                float r1 = dimensions.x*0.5;
                float r2 = dimensions.z*0.5;
                float height = dimensions.y*0.5;

                if(edgetype == 0)
                {
                        value = fCylinder(p, r1, r2, height);
                }
                if(edgetype == 1)
                {
                        value = chamferCylinder(p, r1, r2, height,edgerad);
                }
                if(edgetype == 2)
                {
                        value = roundCylinder(p, r1, r2, height,edgerad);
                }


                
        }
        else if(primtype == \"capsule\")
        {
                float r1 = dimensions.x*0.5;
                float r2 = dimensions.z*0.5;
                float height = dimensions.y;
                value = fCapsule(p, r1, r2, height);
        }
        else if(primtype == \"torus\")
        {
                float r1 = dimensions.x;
                float r2 = dimensions.z;
                float height = dimensions.y;
                value = fTorus(p, r1, r2, height);
        }
        else if(primtype == \"pyramid\")
        {
                vector b = dimensions;
                value = sdPyramid(p, b);
        }
        else if(primtype == \"octahedron\")
        {
                vector b = dimensions;
                value = sdOctahedron( p, b );
        }
        else if(primtype == \"vdb\" || primtype == \"volume\")
        {
                value = volumesample(1, thisprim, pos);
        }
        else if(primtype == \"assyvolume\")
        {
                value = volumeindex(1, thisprim, vid);
        }
        else
        {
                vector b = dimensions*0.5;
                value = fBoxCheap(p, b);
        }

        if(offsettoggle == 1)
        {
                float offsetamt = prim(1,\"offsetamt\", thisprim);
                value -= offsetamt;
        }
        
        if(shelltoggle == 1)
        {
                float shellthickness = prim(1,\"shellthickness\", thisprim);      
                value = abs(value)-shellthickness;
        }

        if(tapertoggle == 1) //normalize distance values after chamfer
        {       
                value /= length(taperposmultiplier)*0.5;
        }

        return value;
}





float combinefunc(int thisprim; float A ; float B)
{
        int combinemode = prim(1, \"combinemode\", thisprim);
        int typeuni = prim(1, \"combinetypeuni\", thisprim);
        int typeinters = prim(1, \"combinetypeinter\", thisprim);
        int typediff = prim(1,\"combinetypediff\", thisprim);
        int typeoth = prim(1,\"combinetypeoth\", thisprim);
        float R = prim(1,\"combinerad\", thisprim);
        int N = prim(1,\"combinecount\", thisprim);
        float RA = prim(1,\"combineradA\", thisprim);
        float RB = prim(1,\"combineradB\", thisprim);



        float result = A;

        //Union
        if(combinemode == 0)
        {
                        if(typeuni == 0) result = fOpUnionChamfer(A, B, R);
                        if(typeuni == 1) result = fOpUnionRound(A, B, R);
                        if(typeuni == 2) result =  fOpUnionColumns(A, B, R, N);
                        if(typeuni == 3) result =  fOpUnionStairs(A, B, R, N);
                        if(typeuni == 4) result =  fOpUnionSoft(A, B, R);
        }

        //Intersect
        if(combinemode == 1)
        {
                        if(typeinters == 0) result =  fOpIntersectionChamfer(A, B, R);
                        if(typeinters == 1) result =  fOpIntersectionRound(A, B, R);
                        if(typeinters == 2) result =  fOpIntersectionColumns(A, B, R, N);
                        if(typeinters == 3) result =  fOpIntersectionStairs(A, B, R, N);
        }

        //Difference
        if(combinemode == 2)
        {
                        if(typediff == 0) result =  fOpDifferenceChamfer (A, B, R);
                        if(typediff == 1) result =  fOpDifferenceRound (A, B, R);
                        if(typediff == 2) result =  fOpDifferenceColumns(A, B, R, N);
                        if(typediff == 3) result =  fOpDifferenceStairs(A, B, R, N);
        }

        //Other
        if(combinemode == 3)
        {
                        if(typeoth == 0) result =  fOpPipe(A, B, R);
                        if(typeoth == 1) result =  fOpEngrave(A, B, R);
                        if(typeoth == 2) result =  fOpGroove(A, B, RA, RB);
                        if(typeoth == 3) result =  fOpTongue(A, B, RA, RB);
                        if(typeoth == 4) result =  fOpOffset(A, B, RA, RB);
        }

        return result;
}



////////////////////////////////////////////////////////////////
//
//             Main Program
//
////////////////////////////////////////////////////////////////

int nprims = nprimitives(1);
float thisvoxel = f@surface;

for(int thisprimid = 0; thisprimid<nprims; thisprimid++)
{
        float A = thisvoxel;
        float B = primfunc(thisprimid,@P,set(@ix,@iy,@iz));
        thisvoxel = combinefunc(thisprimid, A, B);
}

f@surface = thisvoxel;"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
vex_geometrygenerator	[ 0	locks=0 ]	(	"off"	)
vdb_signedflood	[ 0	locks=0 ]	(	"on"	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_precision	[ 0	locks=0 ]	(	auto	)
}

