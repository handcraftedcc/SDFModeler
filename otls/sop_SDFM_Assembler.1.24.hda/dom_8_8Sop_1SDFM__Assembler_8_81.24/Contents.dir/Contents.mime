grouptype	[ 0	locks=0	autoscope=0 ]	(	"prims"	)
computenorms	[ 0	locks=0	autoscope=0 ]	(	"off"	)
negate	[ 0	locks=0	autoscope=0 ]	(	"off"	)
fillhole	[ 0	locks=0	autoscope=0 ]	(	"off"	)
removegrp	[ 0	locks=0	autoscope=0 ]	(	"off"	)
attrib	[ 0	locks=0	autoscope=0 ]	(	combinemode	)
value	[ 0	locks=0	autoscope=0 ]	(	0	)
}

