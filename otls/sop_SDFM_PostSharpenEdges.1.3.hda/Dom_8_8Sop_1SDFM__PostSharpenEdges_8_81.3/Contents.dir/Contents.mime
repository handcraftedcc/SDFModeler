--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/attribwrangle14.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	!nonedgepts	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"point"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"// FUNCTIONS

float anglefromvectors(vector aim; vector up)
{
    float angle = degrees(acos(dot(aim,up)));
    return angle;
}

vector intersectlinewithplane( vector linePos; vector lineDir; vector planePos; vector planeNorm)
{
    vector intersection;
    // Ensure the line direction and plane normal are normalized
    lineDir = normalize(lineDir);
    planeNorm = normalize(planeNorm);
    
    // Calculate the dot product between line direction and plane normal
    float dotProd = dot(lineDir, planeNorm);
    
    // Check if the line and plane are parallel
    if (abs(dotProd) < 1e-6)
    {
        // The line and plane are parallel (no intersection or infinite intersections)
    }
    else
    {
        // Find the parameter t for the intersection point
        float t = dot(planePos - linePos, planeNorm) / dotProd;
    
        // Calculate the intersection point
        intersection = linePos + t * lineDir;
    
        // intersection now contains the intersection point
    }
    return intersection;
}

vector findIntersectionLineDir(vector norm1; vector norm2)
{
    //---- Find Intersection Line -----//
    
    // Normalize the normals
    norm1 = normalize(norm1);
    norm2 = normalize(norm2);
    
    vector lineDir;
    
    // Check if planes are parallel
    if (abs(dot(norm1, norm2)) >= 1 - 1e-6)
    {
        // Planes are parallel (no intersection or are the same plane)
    }
    else
    {
        // Find direction of intersection line
        // Calculate direction of the intersection line
        lineDir = cross(norm1, norm2);
    }
    return lineDir;
}

vector findClosestPointOnLine(vector pointPos; vector LineP; vector LineDir)
{
    
    // Ensure the line direction is a unit vector
    LineDir = normalize(LineDir);
    
    // Vector from the line's point to the given point
    vector vecToPoint = pointPos - LineP;
    
    // Project vecToPoint onto lineDir
    float projLength = dot(vecToPoint, LineDir);
    
    // Calculate the closest point on the line
    vector closestPoint = LineP + projLength * LineDir;
    
    return closestPoint;
}

vector findClosestPointOnSurface( vector planePos; vector planeNorm; vector point)     // The given point
{
    
    
    // Ensure the plane normal is normalized
    planeNorm = normalize(planeNorm);
    
    // Compute the vector from the point on the plane to the given point
    vector vecToPoint = point - planePos;
    
    // Project this vector onto the plane normal
    float distanceToPlane = dot(vecToPoint, planeNorm);
    
    // Compute the closest point on the plane
    vector closestPointOnPlane = point - distanceToPlane * planeNorm;
    
    return closestPointOnPlane;
}

vector averagePointVectors(int points[]; string attributename)
{
    vector pointVs[];
    foreach(int idx; int thispt; points)
    {
        pointVs[idx] = point(1,attributename,thispt);
    }
    vector pointsVavg = avg(pointVs);
    return pointsVavg;
}



// PROGRAM

float searchdist = chf(\"searchdist\");
int maxsearchpoints = chi(\"maxsearchpoints\");
float differintiatorangle = chf(\"differintiatorangle\");
float maxoffset = chf(\"maxoffset\");
float cornermaxoffset = chf(\"cornermaxoffset\");
float planedistancecomparethresh = chf(\"planedistancecomparethreshold\");

int nearpts[] = nearpoints(1,@P,searchdist,maxsearchpoints);

int planect = 0;
//int plane0pts[]; //For points with the same angle as the main point -> disregard
int plane1pts[];
vector planemasterNs[];
vector plane1masterN;
int plane2pts[];
vector plane2masterN;
int plane3pts[];
vector plane3masterN;
int plane4pts[];
int plane5pts[];
int plane6pts[];
int planeXpts[]; //For points not in the first 3 planes
vector newpos;

foreach(int idx; int nearpt; nearpts)
{
    vector nearpointP = point(1,\"P\",nearpt);
    vector nearpointN = point(1,\"N\",nearpt);
    int currentplane = 0;
    int maxiters = 100;
    int thisitter = 0;
    
    while(currentplane < 7)
    {
        int breaker = 0;
        //check if current plane is brand new
        int planemasterlen = len(planemasterNs);
        if(planemasterlen<=currentplane)
        {
            // if yes then write point to array and set as master N
            if(currentplane == 0)
            {
                push(plane1pts,nearpt);
            }
            if(currentplane == 1)
            {
                push(plane2pts,nearpt);
            }
            if(currentplane == 2)
            {
                push(plane3pts,nearpt);
            }
            if(currentplane == 3)
            {
                push(plane4pts,nearpt);
            }
            if(currentplane == 4)
            {
                push(plane5pts,nearpt);
            }
            if(currentplane == 5)
            {
                push(plane6pts,nearpt);
            }
            planemasterNs[currentplane] = point(1,\"N\",nearpt);
            break;
        }
        else
        {
            // if not then see if the current vector matches the current plane masterpoint
            vector thisplanediffangle = anglefromvectors(planemasterNs[currentplane],nearpointN);
            if(thisplanediffangle<differintiatorangle)
            {
                // if yes: add it to this plane points
                if(currentplane == 0)
                {
                    push(plane1pts,nearpt);
                }
                if(currentplane == 1)
                {
                    push(plane2pts,nearpt);
                }
                if(currentplane == 2)
                {
                    push(plane3pts,nearpt);
                }
                if(currentplane == 3)
                {
                    push(plane4pts,nearpt);
                }
                if(currentplane == 4)
                {
                    push(plane5pts,nearpt);
                }
                if(currentplane == 5)
                {
                    push(plane6pts,nearpt);
                }
                break;
            }
            else
            {
                currentplane+=1;
            }
        }

    }
    planect = max(planect,currentplane+1);

}

planect = min(planect,4);

// Average out point Normals and Positions

vector planePavg[];
vector planeNavg[];
vector plane1Pavg;
vector plane1Navg;
float planedists[];
if(planect>=1)
{

    plane1Navg = averagePointVectors(plane1pts, \"N\");
    plane1Pavg = averagePointVectors(plane1pts, \"P\");
    vector closept = findClosestPointOnSurface( plane1Pavg, plane1Navg, @P);
    planedists[0] = distance(@P,closept);

}

vector plane2Pavg;
vector plane2Navg;
if(planect>=2)
{
    plane2Navg = averagePointVectors(plane2pts, \"N\");
    plane2Pavg = averagePointVectors(plane2pts, \"P\");
    vector closept = findClosestPointOnSurface( plane2Pavg, plane2Navg, @P);
    planedists[1] = distance(@P,closept);
}

vector plane3Pavg;
vector plane3Navg;
if(planect>=3)
{
    plane3Navg = averagePointVectors(plane3pts, \"N\");
    plane3Pavg = averagePointVectors(plane3pts, \"P\");
    vector closept = findClosestPointOnSurface( plane3Pavg, plane3Navg, @P);
    planedists[2] = distance(@P,closept);
}

vector plane4Pavg;
vector plane4Navg;
if(planect>=4)
{
    plane4Navg = averagePointVectors(plane4pts, \"N\");
    plane4Pavg = averagePointVectors(plane4pts, \"P\");
    vector closept = findClosestPointOnSurface( plane4Pavg, plane4Navg, @P);
    planedists[3] = distance(@P,closept);
}

//Calculate Distance to each plane, and see how they compare. If surfaces are away widely differently, then disregard others.
float lastplanedist;
int planectdists = 1;
foreach(int idx; float thisplanedist; planedists)
{
    if(idx == 0) continue;
    if(abs(planedists[idx]-planedists[0])>planedistancecomparethresh) break;
    planedistancecomparethresh*=0.75;
    planectdists = idx+1;
    lastplanedist = planedists[idx];
}
f[]@planedists = planedists;
f@lastplanedist = lastplanedist;

//Calculate Plane Intersections

if(planectdists == 1)
{
    vector linep = @P;
    vector linedir = @N;
    vector planeP = plane1Pavg ; // Plane position
    vector planeN = plane1Navg; // Plane normal
    
    vector intersection = intersectlinewithplane( @P, @N, planeP, planeN);
    vector closestpoint = findClosestPointOnSurface( planeP, planeN, @P);
    
    newpos = closestpoint;
    setpointgroup(0,\"type_planar\",@ptnum,1,\"set\");
}

if(planectdists >= 2)
{

    vector pos1 = plane1Pavg; // Position on Plane 1
    vector norm1 = plane1Navg; // Normal of Plane 1
    
    vector pos2 = plane2Pavg; // Position on Plane 2
    vector norm2 = plane2Navg;; // Normal of Plane 2
    
    vector IntersLineP;
    vector IntersLineN;
    
    //---- Find Intersection Line -----//
    IntersLineN = findIntersectionLineDir(norm1,norm2);

    vector pt1towintersection = cross(norm1, IntersLineN);
    
    //Intersect line with plane
    IntersLineP = intersectlinewithplane( pos1, pt1towintersection, pos2, norm2);
    
    //---- Find Closest Point On Intersection Line -----//
    vector closestPoint = findClosestPointOnLine(@P, IntersLineP, IntersLineN);
    
    
    
    if(planectdists == 2)
    {
        newpos = closestPoint;
        setpointgroup(0,\"type_edge\",@ptnum,1,\"set\");
    }
    else if(planectdists >= 3)
    {
        vector pos3 = plane3Pavg; // Position on Plane 3
        vector norm3 = plane3Navg;; // Normal of Plane 3
        //Intersect initial intersection line with 3rd plane;
        vector IntersPoint = intersectlinewithplane( IntersLineP, IntersLineN, pos3, norm3);
        newpos = IntersPoint;
        setpointgroup(0,\"type_corner\",@ptnum,1,\"set\");
    }
    

        
}

if(distance(newpos,@P)<maxoffset)
{   
    //if(distance(newpos,@P)>chf(\"movedetectthreshold\")) setpointgroup(0,\"moved\",@ptnum,1,\"set\");
    @P=newpos;
}
i@planect = planect;



"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
folder_generatedparms_snippet	[ 0	locks=0 ]	(	0	)
searchdist	[ 8	locks=0 ]	(	[ searchdist	0 ] 	)
maxsearchpoints	[ 0	locks=0 ]	(	[ maxsearchpoints	0 ] 	)
sharpangle	[ 0	locks=0 ]	(	0	)
differintiatorangle	[ 0	locks=0 ]	(	[ differintiatorangle	0 ] 	)
maxoffset	[ 0	locks=0 ]	(	[ maxoffset	0 ] 	)
cornermaxoffset	[ 0	locks=0 ]	(	[ cornermaxoffset	0 ] 	)
movedetectthreshold	[ 0	locks=0 ]	(	[ movedetectthreshold	0 ] 	)
planedistancecomparethreshold	[ 0	locks=0 ]	(	[ planedistancecomparethreshold	0 ] 	)
}

