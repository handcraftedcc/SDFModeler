                type    float
                default { "0" }
                hidewhen "{ combinemode != 3 } { typeoth != 4 }"
                range   { -0.25 0.25 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "import_source" "op:SDFM_Properties1" }
                parmtag { "import_token" "offset" }
                parmtag { "script_callback_language" "python" }
