                parmtag { "autoscope" "0000000000000000" }
                parmtag { "import_source" "op:SDFM_Properties1" }
                parmtag { "import_token" "typediff" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "typeoth"
                label   "Type"
                type    ordinal
                default { "0" }
                hidewhen "{ combinemode != 3 }"
                menu {
                    "0" "Pipe"
                    "1" "Engrave"
                    "2" "Groove"
                    "3" "Tongue"
                    "4" "Offset"
                }
