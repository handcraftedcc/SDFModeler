    groupcollapsible {
        name    "folder0"
        label   "Output"

        parm {
            name    "assemblyName"
            label   "Assemby Name"
            type    string
            default { [ "$OS" hscript-expr ] }
            help    "Assembly name for keeping track. Not essential to functionality."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "volumepostprocessing"
            label   "Volume Post Processing"
            type    ordinal
            default { "0" }
            help    "None: The fastest, and best for when editing.   Convert to VDB: Converts volume to VDB   VDB+Optimize: Converts to VDB but also trims off empty parts of VDB. Great for effecient storage. Might impact detail level a little bit.   Prep for reuse: If you want to use the volume output of this assembler in another assembler this will prepare the volume for that."
            menu {
                "0" "None"
                "1" "Convert to VDB"
                "2" "VDB + Optimize"
                "3" "Prep for Reuse"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "vdbextrapolate7_dilate"
            label   "Dilation"
            type    integer
            default { "40" }
            help    "Dilates the volume. If you run into edges when doing things like bevels or chamfers upping this should help get rid of those."
            hidewhen "{ volumepostprocessing != 3 }"
            range   { 0! 10 }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "houdini_utils::doc" "Specifies the number of voxels around an SDF narrow-band to be dilated." }
