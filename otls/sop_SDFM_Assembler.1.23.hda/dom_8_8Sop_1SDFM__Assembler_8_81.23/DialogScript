                name    "typeinters"
                label   "Type"
                type    ordinal
                default { "0" }
                hidewhen "{ combinemode != 1 }"
                menu {
                    "0" "Chamfer"
                    "1" "Round"
                    "2" "Columns"
                    "3" "Stairs"
                }
                range   { 0 10 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "import_source" "op:SDFM_Properties1" }
                parmtag { "import_token" "typeinters" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "typediff"
