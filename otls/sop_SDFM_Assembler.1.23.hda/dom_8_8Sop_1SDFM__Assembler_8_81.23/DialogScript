                type    toggle
                default { "on" }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "import_source" "op:SDFM_Properties1" }
                parmtag { "import_token" "colorbymode" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "combinemode"
                label   "Mode"
                type    ordinal
                default { "0" }
                menu {
                    "0" "Union"
                    "1" "Intersect"
                    "2" "Difference"
                    "3" "Other"
                }
                range   { 0 10 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "import_source" "op:SDFM_Properties1" }
                parmtag { "import_token" "combinemode" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "typeuni"
                label   "Type"
