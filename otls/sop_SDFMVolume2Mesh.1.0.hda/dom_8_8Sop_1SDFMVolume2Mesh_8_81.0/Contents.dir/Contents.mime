Content-Disposition: attachment; filename="hdaroot/vdbsmoothsdf4.chn"
Content-Type: text/plain

{
    channel operation {
      lefttype = extend
      righttype = extend
      defaultString = \"meanvalue\"
      flags = 0
      segment { length = 0 expr = chs(\"../operation\") }
    }
    channel useworldspaceunits {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../useworldspaceunits\") }
    }
    channel radiusworld {
      lefttype = extend
      righttype = extend
      default = 0.10000000000000001
      flags = 0
      segment { length = 0 value = 0.10000000000000001 0.10000000000000001 expr = ch(\"../radiusworld\") }
    }
    channel radius {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../radius\") }
    }
    channel iterations {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../iterations\") }
    }
  }

