--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/GroupCurves.parm"
Content-Type: text/plain

{
version 0.8
folder0 [ 0 locks=0 ] ( 0 )
group [ 0 locks=0 ] ( "" )
grouptype [ 0 locks=0 ] ( "guess" )
class [ 0 locks=0 ] ( "detail" )
vex_numcount [ 0 locks=0 ] ( 10 )
vex_threadjobsize [ 0 locks=0 ] ( 1024 )
snippet [ 0 locks=0 ] ( "// Detail wrangle after per-curve preparation. Keep the original curves for
// guides, but pack their distance buffers as one descriptor when requested.
if (!chi(\"../curve_singleprimitive\") || nprimitives(0) < 2)
    return;

float samples[];
float maxscale = 0.0;
int count = nprimitives(0);
for (int primnum = 0; primnum < count; ++primnum)
{
    float curve[] = prim(0, \"curve_samples\", primnum);
    if (len(curve) < 8 || len(curve) % 4)
    { error(\"Curve %d has an invalid wire sample buffer.\", primnum); return; }
    // Explicitly close each closed curve before adding a break. The combined
    // descriptor is open so its last curve never wraps to its first curve.
    if (prim(0, \"curve_closed\", primnum))
        for (int component = 0; component < 4; ++component)
            append(curve, curve[component]);
    if (primnum)
    {
        append(samples, 0.0); append(samples, 0.0);
        append(samples, 0.0); append(samples, -1.0);
    }
    for (int i = 3; i < len(curve); i += 4)
        maxscale = max(maxscale, curve[i]);
    append(samples, curve);
}

vector lo, hi;
getbbox(0, lo, hi);
float padding = max(chf(\"../curveradius\"), 0.0) * maxscale;
vector dimensions = max(hi - lo + 2 * padding, set(1e-6, 1e-6, 1e-6));
// Pack SOP transfers attributes from the first primitive in each named piece.
// Store the combined buffer once rather than duplicating it per source curve.
setprimattrib(0, \"curve_samples\", 0, samples);
setprimattrib(0, \"curve_closed\", 0, 0);
setprimattrib(0, \"dimensions\", 0, dimensions);
for (int primnum = 0; primnum < count; ++primnum)
    setprimattrib(0, \"name\", primnum, \"sdfm_curve_all\");
setattribtypeinfo(0, \"prim\", \"dimensions\", \"none\");" )
exportlist [ 0 locks=0 ] ( "*" )
vex_strict [ 0 locks=0 ] ( "off" )
vex_strictvariables [ 0 locks=0 ] ( "on" )
autobind [ 0 locks=0 ] ( "on" )
bindings [ 0 locks=0 ] ( 0 )
groupautobind [ 0 locks=0 ] ( "on" )
groupbindings [ 0 locks=0 ] ( 0 )
vex_cwdpath [ 0 locks=0 ] ( "." )
vex_outputmask [ 0 locks=0 ] ( "*" )
vex_updatenmls [ 0 locks=0 ] ( "off" )
vex_matchattrib [ 0 locks=0 ] ( "id" )
vex_inplace [ 0 locks=0 ] ( "off" )
vex_selectiongroup [ 0 locks=0 ] ( "" )
vex_precision [ 0 locks=0 ] ( "auto" )
folder1 [ 0 locks=0 ] ( 0 )
}


