--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/transform.chn"
Content-Type: text/plain

{
channel tx {
lefttype = extend
righttype = extend
flags = 0
segment { length = 0 expr = ch(\"../tx\") }
}
channel ty {
lefttype = extend
righttype = extend
flags = 0
segment { length = 0 expr = ch(\"../ty\") }
}
channel tz {
lefttype = extend
righttype = extend
flags = 0
segment { length = 0 expr = ch(\"../tz\") }
}
channel rx {
lefttype = extend
