Content-Disposition: attachment; filename="hdaroot/polybevel5.chn"
Content-Type: text/plain

{
    channel offset {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = max(prim(\"../READ\",0,edgerad,0),0.0001) }
    }
    channel divisions {
      lefttype = extend
      righttype = extend
      default = 4
      flags = 0
      segment { length = 0 value = 4 4 expr = ch(\"../beveldivisions\") }
    }
  }

