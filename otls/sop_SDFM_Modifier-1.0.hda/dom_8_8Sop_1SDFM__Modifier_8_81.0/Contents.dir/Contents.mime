    channel sizex {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = if(ch(\"../enableaxisx\")==1,ch(\"../offsetx\"),0.5) }
    }
    channel sizey {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = if(ch(\"../enableaxisy\")==1,ch(\"../offsety\"),0.5) }
    }
    channel sizez {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = if(ch(\"../enableaxisz\")==1,ch(\"../offsetz\"),0.5) }
    }
  }

