--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/copy1.chn"
Content-Type: text/plain

{
    channel ry {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = 360/ch(\"ncy\") }
    }
    channel ncy {
      lefttype = extend
      righttype = extend
      default = 6
      flags = 0
      segment { length = 0 value = 6 6 expr = ch(\"../radialcount\") }
