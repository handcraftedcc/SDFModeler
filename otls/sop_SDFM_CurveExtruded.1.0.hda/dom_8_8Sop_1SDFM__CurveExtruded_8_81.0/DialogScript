{
    name	dom::SDFM_CurveExtruded::1.0

    bindhandle tx xform "Transformer" tx "movetool_candidate(1) ownerop('transform1')"
    bindhandle ty xform "Transformer" ty "movetool_candidate(1) ownerop('transform1')"
    bindhandle tz xform "Transformer" tz "movetool_candidate(1) ownerop('transform1')"
    bindhandle rx xform "Transformer" rx "movetool_candidate(1) ownerop('transform1')"
    bindhandle ry xform "Transformer" ry "movetool_candidate(1) ownerop('transform1')"
    bindhandle rz xform "Transformer" rz "movetool_candidate(1) ownerop('transform1')"
    bindhandle sx xform "Transformer" sx "movetool_candidate(1) ownerop('transform1')"
    bindhandle sy xform "Transformer" sy "movetool_candidate(1) ownerop('transform1')"
    bindhandle sz xform "Transformer" sz "movetool_candidate(1) ownerop('transform1')"
    bindhandle scale xform "Transformer" uniform_scale "movetool_candidate(1) ownerop('transform1')"

    group {
        name    "Parms"
        label   "Parms"

        groupcollapsible {
            name    "folder2"
            label   "Transform"

            parm {
                name    "t"
                label   "Translate"
                type    vector
                size    3
                default { "0" "0" "0" }
                range   { -1 1 }
                parmtag { "autoscope" "1110000000000000" }
            }
            parm {
                name    "r"
                label   "Rotate"
                type    vector
                size    3
                default { "0" "0" "0" }
                range   { 0 360 }
                parmtag { "autoscope" "1110000000000000" }
            }
            parm {
                name    "s"
                label   "Scale"
                type    vector
                size    3
                default { "1" "1" "1" }
                range   { -1 1 }
                parmtag { "autoscope" "1110000000000000" }
            }
            parm {
                name    "scale"
                label   "Uniform Scale"
                type    float
                default { "1" }
                range   { 0 10 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "sepparm"
            label   "Separator"
            type    separator
            default { "" }
        }
        groupsimple {
            name    "curve_settings"
            label   "Curve Settings"

            parm {
                name    "WorkPlane"
                label   "Work Plane"
                type    ordinal
                default { "0" }
                menu {
                    "0" "Auto"
                    "1" "XY"
                    "2" "XZ"
                    "3" "YZ"
                }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "sepparm2"
                label   "Separator"
                type    separator
                default { "" }
            }
            parm {
                name    "curve_kind"
                label   "Curve Kind"
                type    integer
                invisible
                default { "1" }
                range   { 0 10 }
            }
            parm {
                name    "curve_profilemode"
                label   "Profile Mode"
                type    ordinal
                default { "0" }
                menu {
                    "0" "Filled Profile"
                    "1" "Stroked Profile"
                }
            }
            parm {
                name    "curveradius"
                label   "Profile Half Width"
                type    float
                default { "0.05" }
                help    "Local radius multiplied by the source curve pscale. For extrusions this applies to Stroked Profile only."
                hidewhen "{ curve_profilemode == 0 }"
                range   { 0 10 }
            }
            parm {
                name    "curve_radiusinterp"
                label   "Radius Interpolation"
                type    ordinal
                default { "0" }
                help    "Bezier mode uses pscale on every control vertex, including handles; other modes use anchors."
                menu {
                    "0" "Linear"
                    "1" "Smoothstep"
                    "2" "Monotone Cubic"
                    "3" "Bezier Control Values"
                }
            }
            parm {
                name    "curve_profileoffset"
                label   "Profile Offset"
                type    float
                default { "0" }
                range   { 0 10 }
            }
            parm {
                name    "sepparm3"
                label   "Separator"
                type    separator
                default { "" }
            }
            parm {
                name    "curve_extrudemode"
                label   "Extrusion"
                type    ordinal
                default { "0" }
                menu {
                    "0" "Finite"
                    "1" "Infinite"
                }
            }
            parm {
                name    "curve_extrudedir"
                label   "Curve Extrude Direction"
                type    ordinal
                default { "0" }
                hidewhen "{ curve_extrudemode == 1 }"
                menu {
                    "0" "Unidirectional"
                    "1" "Bidirectional"
                }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "curve_extrudeamount"
                label   "Extrude Amount"
                type    float
                default { "0.5" }
                hidewhen "{ curve_extrudemode == 1 }"
                range   { 0 10 }
            }
            parm {
                name    "sepparm4"
                label   "Separator"
                type    separator
                default { "" }
            }
            parm {
                name    "edgetype"
                label   "Cap Edge Style"
                type    ordinal
                default { "0" }
                hidewhen "{ curve_extrudemode == 1 }"
                menu {
                    "0" "Sharp"
                    "1" "Chamfer"
                    "2" "Round / Bevel"
                }
            }
            parm {
                name    "edgerad"
                label   "Cap Edge Radius"
                type    float
                default { "0" }
                hidewhen "{ curve_extrudemode == 1 } { edgetype == 0 }"
                range   { 0 10 }
            }
            parm {
                name    "curve_topedgetype"
                label   "Top Edge Style"
                type    ordinal
                default { "0" }
                help    "Inherit uses the shared cap style and radius. Other entries override this end independently."
                hidewhen "{ curve_extrudemode == 1 }"
                menu {
                    "inherit"   "Inherit"
                    "sharp"     "Sharp"
                    "chamfer"   "Chamfer"
                    "round"     "Round / Bevel"
                }
            }
            parm {
                name    "curve_topedgerad"
                label   "Top Edge Radius"
                type    float
                default { "0" }
                help    "-1 inherits Cap Edge Radius."
                hidewhen "{ curve_extrudemode == 1 } { curve_topedgetype == inherit } { curve_topedgetype == sharp }"
                range   { 0 10 }
            }
            parm {
                name    "curve_bottomedgetype"
                label   "Bottom Edge Style"
                type    ordinal
                default { "0" }
                help    "Inherit uses the shared cap style and radius. Other entries override this end independently."
                hidewhen "{ curve_extrudemode == 1 }"
                menu {
                    "inherit"   "Inherit"
                    "sharp"     "Sharp"
                    "chamfer"   "Chamfer"
                    "round"     "Round / Bevel"
                }
            }
            parm {
                name    "curve_bottomedgerad"
                label   "Bottom Edge Radius"
                type    float
                default { "0" }
                help    "-1 inherits Cap Edge Radius."
                hidewhen "{ curve_extrudemode == 1 } { curve_bottomedgetype == inherit } { curve_bottomedgetype == sharp }"
                range   { 0 10 }
            }
            parm {
                name    "curve_cornerstyle"
                label   "Profile Corner Style"
                type    ordinal
                default { "0" }
                help    "Trims polygon profile corners. Use Bezier handles to shape Bezier corners."
                menu {
                    "0" "Original"
                    "1" "Chamfer"
                    "2" "Round Fillet"
                }
            }
            parm {
                name    "curve_cornerradius"
                label   "Profile Corner Radius"
                type    float
                default { "0" }
                hidewhen "{ curve_cornerstyle == 0 }"
                range   { 0 10 }
            }
        }

        groupsimple {
            name    "folder1"
            label   "Shell"
            grouptag { "group_type" "simple" }
            grouptag { "import_enable" "1" }
            grouptag { "import_source" "op:SDFM_Properties" }
            grouptag { "import_token" "folder1:Shell" }

            parm {
                name    "shelltoggle"
                label   "Shell"
                type    toggle
                default { "off" }
                help    "Enable Shell. Gives thickness to the \"walls\" of the shape, making it a shell instead of a solid object."
                export  all
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "import_source" "op:SDFM_Properties" }
                parmtag { "import_token" "shelltoggle" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "shellthickness"
                label   "Shell Thickness"
                type    float
                default { "0.025" }
                help    "Thickness of Shell"
                hidewhen "{ shelltoggle == 0 }"
                range   { 0.0001 0.5 }
                export  all
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "import_source" "op:SDFM_Properties" }
                parmtag { "import_token" "shellthickness" }
                parmtag { "script_callback_language" "python" }
            }
        }

        groupsimple {
            name    "folder0"
            label   "Combine Settings"
            grouptag { "import_enable" "1" }
            grouptag { "import_source" "op:SDFM_Properties" }
            grouptag { "import_token" "folder0:Combine Settings" }

            parm {
                name    "colorbymode"
                label   "Colorize By Mode"
                type    toggle
                default { "on" }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "import_source" "op:SDFM_Properties" }
                parmtag { "import_token" "colorbymode" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "combinemode"
                label   "Mode"
                type    ordinal
                default { "0" }
                menu {
                    "0" "Union"
                    "1" "Intersect"
                    "2" "Difference"
                    "3" "Other"
                }
                range   { 0 10 }
                export  all
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "import_source" "op:SDFM_Properties" }
                parmtag { "import_token" "combinemode" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "typeuni"
                label   "Type"
                type    ordinal
                default { "0" }
                hidewhen "{ combinemode != 0 }"
                menu {
                    "0" "Chamfer"
                    "1" "Round"
                    "2" "Columns"
                    "3" "Stairs"
                    "4" "Soft"
                }
                range   { 0 10 }
                export  all
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "import_source" "op:SDFM_Properties" }
                parmtag { "import_token" "typeuni" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "typeinters"
                label   "Type"
                type    ordinal
                default { "0" }
                hidewhen "{ combinemode != 1 }"
                menu {
                    "0" "Chamfer"
                    "1" "Round"
                    "2" "Columns"
                    "3" "Stairs"
                }
                range   { 0 10 }
                export  all
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "import_source" "op:SDFM_Properties" }
                parmtag { "import_token" "typeinters" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "typediff"
                label   "Type"
                type    ordinal
                default { "0" }
                hidewhen "{ combinemode != 2 }"
                menu {
                    "0" "Chamfer"
                    "1" "Round"
                    "2" "Columns"
                    "3" "Stairs"
                }
                range   { 0 10 }
                export  all
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "import_source" "op:SDFM_Properties" }
                parmtag { "import_token" "typediff" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "typeoth"
                label   "Type"
                type    ordinal
                default { "0" }
                hidewhen "{ combinemode != 3 }"
                menu {
                    "0" "Pipe"
                    "1" "Engrave"
                    "2" "Groove"
                    "3" "Tongue"
                    "4" "Offset"
                }
                range   { 0 10 }
                export  all
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "import_source" "op:SDFM_Properties" }
                parmtag { "import_token" "typeoth" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "radius"
                label   "Radius"
                type    float
                default { "0" }
                hidewhen "{ combinemode == 3 typeoth == 2 } { combinemode == 3 typeoth == 3 } { combinemode == 3 typeoth == 4 }"
                range   { 0 1 }
                export  all
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "import_source" "op:SDFM_Properties" }
                parmtag { "import_token" "radius" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "offset"
                label   "Offset"
                type    float
                default { "0" }
                hidewhen "{ combinemode != 3 } { typeoth != 4 }"
                range   { -0.25 0.25 }
                export  all
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "import_source" "op:SDFM_Properties" }
                parmtag { "import_token" "offset" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "radiusa"
                label   "Radius A"
                type    float
                default { "0.05" }
                hidewhen "{ combinemode != 3 } { typeoth != 2 typeoth != 3 }"
                range   { 0.001 0.2 }
                export  all
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "import_source" "op:SDFM_Properties" }
                parmtag { "import_token" "radiusa" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "radiusb"
                label   "Radius B"
                type    float
                default { "0.05" }
                hidewhen "{ combinemode != 3 } { typeoth != 2 typeoth != 3 typeoth != 4 }"
                range   { 0.001 0.2 }
                export  all
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "import_source" "op:SDFM_Properties" }
                parmtag { "import_token" "radiusb" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "count"
                label   "Count"
                type    integer
                default { "1" }
                hidewhen "{ combinemode == 0 typeuni == 0 } { combinemode == 0 typeuni == 1 } { combinemode == 0 typeuni == 4 } { combinemode == 1 typeinters == 0 } { combinemode == 1 typeinters == 1 } { combinemode == 2 typediff == 0 } { combinemode == 2 typediff == 1 } { combinemode == 3 }"
                range   { 1 10 }
                export  all
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "import_source" "op:SDFM_Properties" }
                parmtag { "import_token" "count" }
                parmtag { "script_callback_language" "python" }
            }
        }

    }


}
