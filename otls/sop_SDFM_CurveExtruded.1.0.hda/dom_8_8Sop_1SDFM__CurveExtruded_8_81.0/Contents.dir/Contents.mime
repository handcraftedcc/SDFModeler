--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/WritePointsPos.parm"
Content-Type: text/plain

{
version 0.8
folder0 [ 0 locks=0 ] ( 0 )
group [ 0 locks=0 ] ( "" )
grouptype [ 0 locks=0 ] ( "guess" )
class [ 0 locks=0 ] ( "primitive" )
vex_numcount [ 0 locks=0 ] ( 10 )
vex_threadjobsize [ 0 locks=0 ] ( 1024 )
snippet [ 0 locks=0 ] ( "// Primitive wrangle: preserve native controls and prepare a compact XY/radius
// buffer once per SOP cook. The COP consumes curve_samples as a float array.
int vertices[] = primvertices(0, @primnum);
int closed = primintrinsic(0, \"closed\", @primnum);
int basis = i@curvetype;
int profilemode = chi(\"../curve_profilemode\");
int mode = chi(\"../curve_radiusinterp\");
float radius = max(chf(\"../curveradius\"), 0.0);
vector controls[];
float radii[];
int hasvertex = hasvertexattrib(0, \"pscale\");
int haspoint = haspointattrib(0, \"pscale\");
foreach (int vertexnum; vertices)
{
    int pointnum = vertexpoint(0, vertexnum);
    vector p = point(0, \"P\", pointnum); p.z = 0.0;
    float r = 1.0;
    if (hasvertex) r = vertex(0, \"pscale\", vertexnum);
    else if (haspoint) r = point(0, \"pscale\", pointnum);
    if (!isfinite(p.x) || !isfinite(p.y) || !isfinite(r) || r < 0.0)
    { error(\"Curve %d has invalid positions or pscale.\", @primnum); return; }
    append(controls, p); append(radii, r);
}
int n = len(controls);
if (!basis && n > 2 && distance2(controls[0], controls[n-1]) < 1e-16)
{ resize(controls, n-1); resize(radii, n-1); n--; closed = 1; }
if (n < 2 || (!profilemode && (!closed || (!basis && n < 3))))
{ error(\"Filled profiles require a closed curve; use Stroked Profile for open curves.\"); return; }
if (basis && (primintrinsic(0,\"order\",@primnum) != 4 || (closed ? n%3 != 0 : (n-1)%3 != 0)))
{ error(\"Bezier curves must be cubic: 3n closed or 3n+1 open controls.\"); return; }
v[]@curve_ptpositions = controls;
f[]@curve_ptpscales = radii;
i@curve_haspscale = haspoint || hasvertex;
i@curve_closed = closed;
i@curve_basis = basis;
i@primtypeid = 8;
s@name = sprintf(\"sdfm_curve_%08d\", @primnum);

// Polygon feature corners are trimmed before subdivision. The circle is
// tangent to both incident edges; concave corners use the opposite arc turn.
int cornerstyle = chi(\"../curve_cornerstyle\");
float cornerradius = max(chf(\"../curve_cornerradius\"), 0.0);
if (!basis && cornerstyle && cornerradius > 0.0)
{
    vector rounded[]; float roundedr[];
    for (int i=0; i<n; ++i)
    {
        if (!closed && (i==0 || i==n-1))
        { append(rounded,controls[i]); append(roundedr,radii[i]); continue; }
        int prev=(i+n-1)%n, next=(i+1)%n;
        vector a=controls[i]-controls[prev], b=controls[next]-controls[i];
        float la=length(a), lb=length(b);
        if (min(la,lb)<1e-8)
        { append(rounded,controls[i]); append(roundedr,radii[i]); continue; }
        a/=la; b/=lb;
        float turn=a.x*b.y-a.y*b.x;
        float angle=acos(clamp(dot(-a,b),-1.0,1.0));
        if (abs(turn)<1e-5 || angle<1e-4)
        { append(rounded,controls[i]); append(roundedr,radii[i]); continue; }
        float trim=min(cornerradius/tan(angle*0.5),0.49*min(la,lb));
        vector entry=controls[i]-a*trim, exit=controls[i]+b*trim;
        float rin=lerp(radii[i],radii[prev],trim/la);
        float rout=lerp(radii[i],radii[next],trim/lb);
        append(rounded,entry); append(roundedr,rin);
        if (cornerstyle==2)
        {
            float effective=trim*tan(angle*0.5);
            vector center=entry+set(-a.y,a.x,0)*sign(turn)*effective;
            vector v0=entry-center, v1=exit-center;
            float arc=atan2(v0.x*v1.y-v0.y*v1.x,dot(v0,v1));
            int steps=max(2,int(ceil(abs(arc)/0.08)));
            for (int j=1;j<steps;++j)
            {
                float t=float(j)/steps, theta=arc*t;
                vector q=center+set(v0.x*cos(theta)-v0.y*sin(theta),v0.x*sin(theta)+v0.y*cos(theta),0);
                append(rounded,q); append(roundedr,lerp(rin,rout,t));
            }
        }
        append(rounded,exit); append(roundedr,rout);
    }
    controls=rounded; radii=roundedr; n=len(controls);
}

vector lo=controls[0], hi=lo;
foreach (vector p;controls) { lo=min(lo,p); hi=max(hi,p); }
float tolerance=max(length(hi-lo)*1e-4,1e-5);
int anchors=basis ? (closed ? n/3 : (n-1)/3+1) : n;
int spans=closed ? anchors : anchors-1;
float output[];
for (int span=0;span<spans;++span)
{
    int ia=basis ? span*3 : span;
    int ib=basis ? (span*3+3)%n : (span+1)%n;
    vector a=controls[ia], b=controls[ib];
    float r0=radii[ia], r1=radii[ib];
    vector c1=basis ? controls[(ia+1)%n] : a;
    vector c2=basis ? controls[(ia+2)%n] : b;
    float s1=basis ? radii[(ia+1)%n] : r0;
    float s2=basis ? radii[(ia+2)%n] : r1;
    float m0=r1-r0, m1=m0;
    if (mode==2)
    {
        int prev=basis ? ((span+anchors-1)%anchors)*3 : (span+n-1)%n;
        int next=basis ? ((span+2)%anchors)*3 : (span+2)%n;
        float dp=r0-radii[prev], dn=radii[next]-r1, delta=r1-r0;
        if (closed || span>0) m0=dp*delta<=0 ? 0.0 : 2.0*dp*delta/(dp+delta);
        if (closed || span<spans-1) m1=delta*dn<=0 ? 0.0 : 2.0*delta*dn/(delta+dn);
    }
    float flatness=basis ? max(length(c1-lerp(a,b,1.0/3)),length(c2-lerp(a,b,2.0/3))) : 0.0;
    if (profilemode && mode) flatness=max(flatness,radius*max(abs(r1-r0),max(abs(s1-r0),abs(s2-r1))));
    int steps=clamp(int(ceil(sqrt(max(flatness/tolerance,1.0))*2.0)),basis ? 8 : 1,512);
    if (!basis && mode==0) steps=1;
    for (int j=0;j<steps;++j)
    {
        float t=float(j)/steps, u=1-t;
        vector p=basis ? u*u*u*a+3*u*u*t*c1+3*u*t*t*c2+t*t*t*b : lerp(a,b,t);
        float r=lerp(r0,r1,t);
        if (mode==1) r=lerp(r0,r1,t*t*(3-2*t));
        else if (mode==2) r=(2*t*t*t-3*t*t+1)*r0+(t*t*t-2*t*t+t)*m0+(-2*t*t*t+3*t*t)*r1+(t*t*t-t*t)*m1;
        else if (mode==3 && basis) r=u*u*u*r0+3*u*u*t*s1+3*u*t*t*s2+t*t*t*r1;
        append(output,p.x); append(output,p.y); append(output,max(r,0.0));
    }
}
if (!closed)
{ append(output,controls[n-1].x); append(output,controls[n-1].y); append(output,radii[n-1]); }
f[]@curve_samples=output;
v@dimensions=max(hi-lo,set(1e-6,1e-6,abs(chf(\"../curve_extrudeamount\"))));
i@tapertoggle=0; f@taperamount=0; i@taperdir=2; i@taperx=1; i@taperz=1;
f@edgerad2=0.0;
setattribtypeinfo(0,\"prim\",\"curve_ptpositions\",\"none\");
setattribtypeinfo(0,\"prim\",\"dimensions\",\"none\");
" )
exportlist [ 0 locks=0 ] ( "*" )
vex_strict [ 0 locks=0 ] ( "off" )
vex_strictvariables [ 0 locks=0 ] ( "on" )
autobind [ 0 locks=0 ] ( "on" )
bindings [ 0 locks=0 ] ( 0 )
groupautobind [ 0 locks=0 ] ( "on" )
groupbindings [ 0 locks=0 ] ( 0 )
vex_cwdpath [ 0 locks=0 ] ( "." )
vex_outputmask [ 0 locks=0 ] ( "*" )
vex_updatenmls [ 0 locks=0 ] ( "off" )
vex_matchattrib [ 0 locks=0 ] ( "id" )
vex_inplace [ 0 locks=0 ] ( "off" )
vex_selectiongroup [ 0 locks=0 ] ( "" )
vex_precision [ 0 locks=0 ] ( "auto" )
folder1 [ 0 locks=0 ] ( 0 )
}


