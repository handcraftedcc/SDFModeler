grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"detail"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"dict parms = d@parms;
int dictlen = len(parms);
string thekeys[] = keys(parms);

foreach(int idx; string thiskey; thekeys)
{
    int groupfind = find(thiskey,\"group\");
    if(groupfind >= 0)
    {
        string thisval = parms[thiskey];
        setdetailattrib(0,thiskey,thisval,\"set\");
    }
    else
    {
        float thisval = parms[thiskey];
        setdetailattrib(0,thiskey,thisval,\"set\");
    }
}"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
