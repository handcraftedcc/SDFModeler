Content-Type: text/plain

{
    channel strength {
      lefttype = extend
      righttype = extend
      default = 50
      flags = 0
      segment { length = 0 value = 50 50 expr = "detail(\"../READPARMS/\",\"smoothstrength\" + ftoa(detail(\"../foreach_count1/\",\"iteration\",0)),0)" }
    }
    channel filterquality {
      lefttype = extend
